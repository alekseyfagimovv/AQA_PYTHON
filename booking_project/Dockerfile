# 1. Базовый образ. Берем официальный легковесный Linux с установленным Python 3.11
FROM python:3.11-slim

# Устанавливаем uv прямо в систему внутри контейнера
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 2. Рабочая папка. Создаем внутри контейнера папку /app и переходим в нее
WORKDIR /app

# 3. Копируем файлы конфигурации проекта (для кэширования слоев Docker)
COPY pyproject.toml uv.lock ./

# 4. Устанавливаем библиотеки глобально в контейнер (без создания виртуального окружения внутри Docker)
RUN uv pip install --system --no-cache -r pyproject.toml

# 5. Копируем весь остальной код вашего проекта с ПК в папку /app контейнера
COPY . .

# 6. Команда по умолчанию. Выполняется только при ЗАПУСКЕ контейнера (старт сервера)
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
