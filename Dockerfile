# 1. Базовый образ. Берем официальный легковесный Linux с установленным Python 3.11
FROM python:3.11-slim

# 2. Рабочая папка. Создаем внутри контейнера папку /app и переходим в нее
WORKDIR /app

# 3. Копируем файл зависимостей с вашего ПК внутрь контейнера
COPY requirements.txt .

# 4. Устанавливаем библиотеки прямо внутри контейнера без кэша (для экономии места)
RUN pip install --no-cache-dir -r requirements.txt

# 5. Копируем весь остальной код вашего проекта с ПК в папку /app контейнера
COPY . .

# 6. Команда по умолчанию. Выполняется только при ЗАПУСКЕ контейнера (старт сервера)
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
